{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-font-changes.mjs\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checando a regra de tipografia..."
          }
        ]
      }
    ]
  }
}
